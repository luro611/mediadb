# Eigene E-Mail-Adresse eintragen (MusicBrainz verlangt eine Kontaktangabe)
MB_USER_AGENT=MusikDB/1.2 (you@example.com)

# Optional: kostenloser Discogs-Token (discogs.com > Einstellungen > Entwickler) fuer die Discogs-Suche
DISCOGS_TOKEN=
# Optional: 0 = keine iTunes/Deezer-Cover als Ausweichquelle (nur MusicBrainz/Cover Art Archive und eigene Dateien)
COVER_WEB=1

# --- Zugriff (siehe docs/BETRIEB.md) ---
# Passwort fuer die Anmeldung. Leer = keine Anmeldung (fuer einen Nutzer im eigenen Heimnetz ausreichend).
APP_PASSWORD=
# 1 = auch Zugriffe von oeffentlichen Internet-Adressen erlauben. Nicht empfohlen; nur mit Passwort und HTTPS.
ALLOW_PUBLIC=0
# Nur hinter einem Reverse Proxy unter einer Unteradresse (z. B. /musik); der Proxy muss sie vor der Weitergabe entfernen.
BASE_PATH=
